@app.route('/data/lst')
def get_lst_data():
    try:
        # Initialize Earth Engine
        ee_initialized = initialize_earth_engine()
        if ee_initialized:
            # Get Landsat collection for 2024, April, Daytime.  Hardcoded for simplicity as per edited code.
            collection = get_landsat_collection(2024, 4, "Daytime")

            # Process data for Chennai. Hardcoded for simplicity as per edited code.
            data_layer, region = process_landsat_data(collection, "Chennai", "LST", "Daytime")

            # Calculate statistics
            stats = calculate_statistics(data_layer, region)

            return jsonify({
                "status": "success",
                "data": stats
            })
        else:
            return jsonify({
                "status": "error",
                "message": "Earth Engine initialization failed"
            })
    except Exception as e:
        return jsonify({
            "status": "error",
            "message": str(e)
        })

